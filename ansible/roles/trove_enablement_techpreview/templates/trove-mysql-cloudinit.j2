#cloud-config
runcmd:
  - |
    #!/bin/bash
    # K8s service reachability via the trove-mgmt-bridge anchor pod on
    # trove-mgmt-net (geneve overlay). The anchor IP runs haproxy that
    # forwards 5672/5000 to the in-cluster Services.
    echo "Updating /etc/hosts"
    echo '{{ trove_services_vip_ip }} rabbitmq.openstack.svc.cluster.local' >> /etc/hosts
    echo '{{ trove_services_vip_ip }} keystone-api.openstack.svc.cluster.local' >> /etc/hosts
    echo '{{ trove_services_vip_ip }} swift-api.openstack.svc.cluster.local' >> /etc/hosts

    # Write the guest-agent transport_url + control_exchange.
    echo "Updating /etc/trove/conf.d/transport.conf"
    mkdir -p /etc/trove/conf.d
    echo '{{ trove_guest_transport_conf_b64 }}' | base64 -d > /etc/trove/conf.d/transport.conf
    chown debian:root /etc/trove/conf.d/transport.conf

    # make sure the log directory exists that is specified in the trove-guestagent.conf template
    echo "Updating /var/log/trove/guest-agent.log"
    mkdir -p /var/log/trove
    touch /var/log/trove/guest-agent.log
    chown -R debian:root /var/log/trove

    # remove soft link for /etc/mysql/my.cnf
    echo "Removing /etc/mysql/my.cnf"
    sudo rm -f /etc/mysql/my.cnf

    # create new /etc/mysql/my.cnf soft link to /etc/mysql/mariadb.cnf
    echo "Creating /etc/mysql/my.cnf"
    sudo ln -s /etc/mysql/mariadb.cnf /etc/mysql/my.cnf
    sudo chown -h database:database /etc/mysql/my.cnf

    echo "Starting local Docker registry"
    echo '{"bridge": "none", "ip-forward": false, "iptables": false, "insecure-registries": ["localhost:5000", "127.0.0.1:5000", "0.0.0.0:5000"]}' > /etc/docker/daemon.json
    sudo systemctl restart docker
    docker network create --subnet=172.20.0.0/16 trove_docker_net
    docker run -d --network trove_docker_net --ip 172.20.0.22 -p 5000:5000 --restart=always --name registry registry:2

    # Pre-baked datastore image
    if [ -f /var/lib/trove-images/datastore.tar ]; then
      echo "Load datastore image"
      for _i in 1 2 3 4 5; do
        if docker info >/dev/null 2>&1; then break; fi
        sleep 2
      done
      docker load -i /var/lib/trove-images/datastore.tar 2>&1 | head -3
      docker tag mysql:8.4 localhost:5000/mysql:8.4
      docker push localhost:5000/mysql:8.4
    fi

    # Pre-baked datastore backup image.
    if [ -f /var/lib/trove-images/datastore-backup.tar ]; then
      echo "Load datastore backup image"
      for _i in 1 2 3 4 5; do
        if docker info >/dev/null 2>&1; then break; fi
        sleep 2
      done
      docker load -i /var/lib/trove-images/datastore-backup.tar 2>&1 | head -3
      docker tag datastore-backup-image:latest localhost:5000/mysql-backup:8.4
      docker push localhost:5000/mysql-backup:8.4
    fi

    # Restart guest agent service
    echo "Restart guest agent service"
    systemctl try-restart guest-agent.service || true

    # Updating /etc/resolv.conf
    echo "Updating /etc/resolv.conf"
    rm -f /etc/resolv.conf
    cat >/etc/resolv.conf <<RESOLV
    nameserver 1.1.1.1
    nameserver 8.8.8.8
    options timeout:2 attempts:2
    RESOLV
    chattr +i /etc/resolv.conf 2>/dev/null || true

    # copy the os_admin.cnf
    echo "Creating os_admin.cnf"
    until [ -f "/var/lib/mysql/conf.d/os_admin.cnf" ]
    do
         sleep 5
    done
    sudo cp /var/lib/mysql/conf.d/os_admin.cnf /etc/mysql/conf.d
    sudo chown database:database /etc/mysql/conf.d/os_admin.cnf

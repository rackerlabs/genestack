#!/bin/bash
# Guarantee a persistent, renewing DHCP client on the Trove mgmt NIC.
#
# Root cause this addresses:
# On the Debian guest (ifupdown + isc-dhcp-client, no systemd-networkd), the
# mgmt-NIC DHCP lease is acquired once at boot but no dhclient daemon is left
# resident to renew it. The lease is never renewed at T1/T2 and lapses at
# expiry (~12h); dhclient then removes the mgmt IPv4 address, every route
# through it (the mgmt routes 0.0.0.0/1 + 128.0.0.0/1 via the anchor gateway)
# is dropped, and the guest-agent loses its RabbitMQ/Keystone/Swift path with
# "[Errno 101] ENETUNREACH" until reboot. Ubuntu guests use systemd-networkd,
# which renews the lease in-daemon -- which is why this was Debian-only.
#
# This installs a systemd service that runs dhclient in the foreground (-d)
# for the mgmt NIC, so a renewing client is always resident. dhclient handles
# T1/T2 renewal itself; systemd restarts it if it ever exits. The rfc3442
# exit hook (see 14-classless-routes-hook) reinstalls the option-121 routes
# on each renewal event.
#
# Interface detection (no hardcoded ens4):
# The mgmt NIC is identified at runtime as the interface carrying the DHCP
# option-121 "split default" routes (0.0.0.0/1 and 128.0.0.0/1 via the anchor
# gateway). That signature is what makes an interface the Trove mgmt NIC and
# is independent of the interface name and of the mgmt subnet CIDR. A shared
# helper (/usr/local/sbin/trove-detect-mgmt-nic) is installed and used by both
# this unit and the ens-reaper unit.
set -e
set -o xtrace

# ---------------------------------------------------------------------------
# Shared helper: print the mgmt NIC name on stdout, exit 0 if found.
# Detection order:
#   1) interface with a "0.0.0.0/1 via <gw>" route (option-121 fingerprint)
#   2) fallback: interface with a "128.0.0.0/1 via <gw>" route
# ---------------------------------------------------------------------------
HELPER=/usr/local/sbin/trove-detect-mgmt-nic
mkdir -p /usr/local/sbin
cat > "${HELPER}" <<'EOF'
#!/bin/sh
# Print the Trove mgmt NIC device name (the interface carrying the option-121
# split-default routes). Exit 0 on success, 1 if not found.
dev=$(ip -4 route show | awk '/^0\.0\.0\.0\/1 /{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
if [ -z "$dev" ]; then
    dev=$(ip -4 route show | awk '/^128\.0\.0\.0\/1 /{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
fi
[ -n "$dev" ] || exit 1
echo "$dev"
EOF
chmod +x "${HELPER}"

UNIT=/etc/systemd/system/trove-mgmt-dhclient.service

cat > "${UNIT}" <<'EOF'
[Unit]
Description=Persistent renewing DHCP client for the Trove mgmt NIC
Documentation=man:dhclient(8)
After=network.target
Wants=network.target

[Service]
Type=simple
# Wait until the mgmt NIC can be detected (option-121 routes present), then
# exec a foreground dhclient on it so systemd supervises the resident client
# that renews the lease at T1/T2. Detecting the device here (rather than a
# hardcoded name) keeps this working regardless of NIC naming.
ExecStartPre=/bin/sh -c 'until /usr/local/sbin/trove-detect-mgmt-nic >/dev/null 2>&1; do sleep 2; done'
ExecStart=/bin/sh -c 'exec /sbin/dhclient -d -4 "$(/usr/local/sbin/trove-detect-mgmt-nic)"'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl enable trove-mgmt-dhclient.service
